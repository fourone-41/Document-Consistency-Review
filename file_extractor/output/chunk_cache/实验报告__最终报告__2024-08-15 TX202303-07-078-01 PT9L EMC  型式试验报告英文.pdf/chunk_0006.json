    {
      "req_id": "6.4-setup-1",
      "description": "For table-top equipment, EUT placed on non-conductive table 0.8m high; for floor-standing equipment, mounted on non-conductive support 0.1m above supporting plane."
    },
    {
      "req_id": "6.4-setup-2",
      "description": "A minimum of 1m of cable exposed to electromagnetic field; excess cable bundled low-inductively in approximate center to form bundle 30–40cm in length."
    },
    {
      "req_id": "6.4-setup-3",
      "description": "EUT initially placed with one face coincident with the calibration plane; illuminated face contained within the UFA (Uniform Field Area)."
    },
    {
      "req_id": "6.4-setup-4",
      "description": "Test distances: 3m for frequencies between 1970MHz and 5785MHz; 2.5m for frequencies between 385MHz and 1970MHz."
    },
    {
      "req_id": "6.4-setup-5",
      "description": "Dwell time of amplitude modulated carrier at each frequency not less than time necessary for EUT to be exercised and respond, and not less than 1s."
    },
    {
      "req_id": "6.4-setup-6",
      "description": "Test performed with generating antenna facing each side of EUT."
    },
    {
      "req_id": "6.4-setup-7",
      "description": "Each selected side tested twice: once with antenna vertical and once with antenna horizontal."
    },
    {
      "req_id": "6.4-setup-8",
      "description": "EUT performance monitored via video camera and/or audio monitor during testing."
    }
