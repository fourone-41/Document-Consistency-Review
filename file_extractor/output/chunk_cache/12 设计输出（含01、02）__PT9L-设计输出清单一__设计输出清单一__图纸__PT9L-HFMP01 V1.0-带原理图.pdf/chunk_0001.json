  "semantic_fragments": [
    {
      "fragment_type": "working_principle",
      "content": "电源控制逻辑：DO_PCTL低电平时3.3V OFF，DO_PCTL高电平时3.3V ON。LED控制：低电平LED亮，高电平LED灭。蜂鸣器工作频率：4kHz。升压芯片U1(SR1833)将电池电压VBAT升压后提供3.3V给系统。",
      "topic_tags": [
        "电源控制",
        "LED控制",
        "蜂鸣器",
        "升压电路"
      ],
      "related_subjects": [
        "U1",
        "SR1833",
        "DO_PCTL",
        "BUZZER",
        "LEDR",
        "LEDW",
        "LEDY"
      ]
    },
    {
      "fragment_type": "working_principle",
      "content": "MCU(BH67F2762)通过模拟输入AI_AN0~AI_AN4采集传感器信号及NTC温度信号，通过LCD段码驱动接口（COM0-COM3, SEG0-SEG11）驱动LCD显示，通过SPI接口（SDI/SDO/SCS/SCK）与红外传感器通信，通过ICP接口（ICPDA/ICPCK）进行在线编程。低电压检测通过AI_LVD（R1/R2分压VBAT）实现。NTC温度检测通过R15上拉至3.3V与NTC分压后接AI_NTC实现。",
      "topic_tags": [
        "MCU",
        "ADC",
        "LCD驱动",
        "SPI",
        "ICP编程",
        "LVD",
        "NTC温度检测"
      ],
      "related_subjects": [
        "U2",
        "BH67F2762",
        "NTC",
        "LCD",
        "SENSOR",
        "ICP",
        "R1",
        "R2",
        "R15"
      ]
    },
