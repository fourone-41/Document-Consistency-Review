  "semantic_fragments": [
    {
      "fragment_type": "working_principle",
      "content": "PT9L红外体温计是基于红外技术测量人体额面温度的体温计。测量时利用红外测温探头测量额面温度进而计算出人体内核的温度。电源采用两节7号电池。用于儿童及成人在正常或发烧状态下的体温测量。",
      "topic_tags": [
        "红外体温计",
        "额面温度",
        "内核温度",
        "工作原理"
      ],
      "related_subjects": [
        "PT9L",
        "软件测试计划"
      ]
    },
    {
      "fragment_type": "behavioral_spec",
      "content": "软件功能：1.MCU系统初始化，配置相关模块的模式和功能设置；2.测量人体表面温度，计算出人体内核的温度（通过AD采集接口）；3.片内EEPROM标定参数数据读取；4.AD采集、判断电池电压状态（通过AD采集端口）；5.LCD显示（通过数据端口）。输入：红外传感器信号输入、电池电量采集信号输入、按键触发信号输入、EEPROM数据读取。输出：蜂鸣器驱动信号、LCD显示信号输出。",
      "topic_tags": [
        "MCU",
        "EEPROM",
        "AD采集",
        "LCD",
        "蜂鸣器",
        "软件功能"
      ],
      "related_subjects": [
        "PT9L",
        "软件需求规格书"
      ]
    },
    {
      "fragment_type": "constraint_statement",
      "content": "测试方法缩写字母说明：S：模拟软件单步执行，观察程序执行的结果；C：输入不同值，确认软件的输出是否和人工计算的一致；O：执行软件，观察硬件的响应；I：改变硬件的输入，确认软件的响应。",
      "topic_tags": [
        "测试方法",
        "单步执行",
        "输入输出验证",
        "硬件观察"
      ],
      "related_subjects": [
