  "semantic_fragments": [
    {
      "fragment_type": "scope_limitation",
      "content": "本计划作为软件部分的设计和开发策划的结束，识别了必要的任务、阶段，规定了人员职责、必要的资源支持、相关评审要求、各阶段接收准则、软件配置管理要求以及异常报告和解决程序等内容。本软件质量策划在软件生命周期策划部分中包含了软件确认计划相关内容。",
      "topic_tags": [
        "软件质量策划",
        "生命周期策划",
        "软件确认计划",
        "人员职责",
        "评审要求"
      ],
      "related_subjects": [
        "PT9L红外体温计软件",
        "软件生命周期"
      ]
    },
    {
      "fragment_type": "design_rationale",
      "content": "软件风险分析：软件相关的风险分析已经在设计输入前的风险评价时进行，具体见《风险评价报告V1.0》(PT9L-FXPJ01 V1.0)。",
      "topic_tags": [
        "软件风险分析",
        "风险评价报告"
      ],
      "related_subjects": [
        "PT9L-FXPJ01 V1.0",
        "风险评价"
      ]
    },
    {
      "fragment_type": "constraint_statement",
      "content": "软件版本管理要求：本软件是基于单片机系统的、结构相对简单的软件设计，不涉及操作系统，软件的总体机器代码量不得超过60Kbytes。开发设计过程由一名软件工程师负责，其他工程师仅参与评审和测试等任务活动，因此针对软件配置管理方面，做下述版本管理要求：A 在软件测试或提交评审前，应确定其版本号；B 所有测试报告应与相应软件版本相对应；C 若有软件更新，则应更新软件版本编号。",
      "topic_tags": [
        "软件版本管理",
        "配置管理",
        "版本编号",
        "单片机",
        "代码量限制"
      ],
      "related_subjects": [
        "PT9L红外体温计软件",
        "软件测试报告"
      ]
    },
    {
      "fragment_type": "behavioral_spec",
      "content": "问题报告与解决程序：测试人员，测试软件过程中发现错误后，修改软件代码，完成修改后需要对程序进行再次测试。",
      "topic_tags": [
        "问题报告",
        "缺陷修复",
        "回归测试",
        "软件测试"
      ],
      "related_subjects": [
        "验证测试阶段",
        "软件代码"
      ]
    },
    {
