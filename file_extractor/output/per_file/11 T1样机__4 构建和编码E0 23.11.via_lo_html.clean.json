      "date": "2024.2.27"
    }
  ],
  "tests": [
    {
      "test_id": "1",
      "item": "初始化功能",
      "condition": "上电后或关机态按按键开机",
      "expected_value": "1.体温计能开机并打开LCD显示；2.MCU系统功能初始化，配置相关模块和功能设置，读取EEPROM存储信息",
      "pass_criteria": "S.O",
      "instrument": "e-link 仿真器"
    },
    {
      "test_id": "2",
      "item": "关机功能",
      "condition": "测量结束后无按键操作15秒；模式设置界面无按键操作3秒",
      "expected_value": "1.达15秒后关闭外设，单片机进入低功耗状态；2.模式设置界面3秒后自动关机",
      "pass_criteria": "S",
      "instrument": "e-link 仿真器"
    },
    {
      "test_id": "3",
      "item": "LCD显示功能",
      "condition": "首次上电、测量完成、发烧提示场景",
      "expected_value": "1.首次上电LCD全屏显示3秒；2.测量完成后LCD显示测量温度结果、单位、电量等信息；3.结合测试结果给出发烧提示，用背光颜色区分",
      "pass_criteria": "S.O.C.I",
      "instrument": "e-link 仿真器"
    },
    {
      "test_id": "4",
      "item": "蜂鸣器提示功能",
      "condition": "测试完成、设置完成、按键操作时",
      "expected_value": "1.首次上电时蜂鸣器长鸣；2.成功长鸣，发烧连续四次短鸣；3.模式设置界面选择时短鸣，确认后长鸣",
      "pass_criteria": "S.O.C.I",
      "instrument": "e-link 仿真器"
    },
    {
      "test_id": "5",
      "item": "低电压检测功能",
      "condition": "电源电压低于2.7V或2.5V",
      "expected_value": "1.电压2.5V–2.7V时LCD提示低电压并保存低电状态；2.电压小于2.5V时LCD提示超低电压后关机",
      "pass_criteria": "S.O.C.I",
      "instrument": "e-link 仿真器"
    },
    {
      "test_id": "6",
      "item": "测量模式设置功能",
      "condition": "开机状态下短按设置按键",
      "expected_value": "1.短按设置按键切换测量模式；2.按下测量按键保存当前模式并完成一次测量；3.15s无操作关机",
      "pass_criteria": "S.O.C.I",
      "instrument": "e-link 仿真器"
    },
    {
      "test_id": "7",
      "item": "单位切换功能",
      "condition": "长按测量按键8秒后进入单位切换",
      "expected_value": "出现单位图标闪烁，短按切换单位，长按2秒后图标停止闪烁，3秒后关机；进入设置后15秒无操作关机",
      "pass_criteria": "S.O.C",
      "instrument": "e-link 仿真器"
    },
    {
      "test_id": "8",
      "item": "测量功能",
      "condition": "短按测量按键或长按2秒进行深度测量",
      "expected_value": "1.短按1秒内完成测量，蜂鸣器提示，LCD显示结果；2.深度测量长按2秒后完成，蜂鸣器提示，LCD显示结果",
      "pass_criteria": "S.O.C.I",
      "instrument": "e-link 仿真器"
    },
    {
      "test_id": "9",
      "item": "错误检测功能",
      "condition": "工作环境温度超出范围或测量结果超出量程",
      "expected_value": "1.环境温度超出10~40℃时LCD闪烁显示\"Err\"；2.测温大于42.9℃或小于32℃时提示\"---℃\"，不显示结果",
      "pass_criteria": "S.O.C.I",
      "instrument": "e-link 仿真器"
    },
    {
      "test_id": "10",
      "item": "记忆功能",
      "condition": "测量成功后存储、长按设置键3秒查看记忆、关机状态同时长按测量键和设置键8秒清空",
      "expected_value": "1.每次测量成功保存数据到EEPROM；2.长按设置键3秒进入记忆查看模式，只能查看对应测量模式的记忆数据；3.同时长按两键8秒可清空记忆",
      "pass_criteria": "S.O.C.I",
      "instrument": "e-link 仿真器"
    }
  ],
  "semantic_fragments": [
    {
      "fragment_type": "working_principle",
      "content": "软件工程师根据软件设计方案和软件流程图进行软件的构建和编码工作，构建程序框架，编写子程序并形成功能模块，调试、测试，全通过后输出软件代码和相关文件，并汇总设计需求、设计方案、子程序、以及测试方面追溯表。",
