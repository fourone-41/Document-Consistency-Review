      "name": "侯广伟",
      "title": "审核人"
    }
  ],
  "tests": [
    {
      "test_id": "操作-1",
      "item": "安装电池",
      "expected_value": "电池安装完毕后，LCD全显，且蜂鸣器\"滴\"一下",
      "pass_criteria": "正常/异常"
    },
    {
      "test_id": "操作-2",
      "item": "在婴儿模式测量体温",
      "expected_value": "待机状态下，用户按键测量额温，LCD能显示体温数据",
      "pass_criteria": "正常/异常"
    },
    {
      "test_id": "操作-3",
      "item": "在成人模式测量体温",
      "expected_value": "显示婴儿体温数据状态下，用户短按设置按键，切换到成人模式，短按测量键测量额温，LCD能显示体温数据",
      "pass_criteria": "正常/异常"
    },
    {
      "test_id": "操作-4",
      "item": "在物温模式测量物温",
      "expected_value": "显示成人体温数据状态下，用户短按设置按键，切换到物温模式，短按测量键测量恒温物体物温，LCD能显示物温数据",
      "pass_criteria": "正常/异常"
    },
    {
      "test_id": "操作-5",
      "item": "关机",
      "expected_value": "测量结束后，不对体温计操作，等待自动关机",
      "pass_criteria": "正常/异常；关机时间感受：较长/合理/较短"
    },
    {
      "test_id": "性能-1",
      "item": "准确性测试",
      "condition": "1. 提供经过校验的体温计，用户测量体温3次；2. 提供经过校验的水银体温计，用户测量腋温1次",
      "pass_criteria": "记录测量数据，与校验体温计/水银体温计比对"
    },
    {
      "test_id": "性能-2",
      "item": "重复性测试",
      "condition": "用户测量体温，连续测量10次",
      "pass_criteria": "记录10次测量值；用户主观评价：很准/一般/不准"
    },
    {
      "test_id": "其他-1",
      "item": "体温计的LCD显示",
      "expected_value": "LCD亮度适宜，显示内容明确易懂",
      "pass_criteria": "亮度：刺眼/很好/一般/太暗；内容：内容明确/能懂/看不懂"
    },
    {
      "test_id": "其他-2",
      "item": "体温计的反应速度",
      "expected_value": "反应迅速，测量过程快，简单易用",
      "pass_criteria": "很迅速/一般/慢"
    },
    {
      "test_id": "其他-3",
      "item": "需要改进的部分",
      "pass_criteria": "用户填写改进建议"
    }
  ],
