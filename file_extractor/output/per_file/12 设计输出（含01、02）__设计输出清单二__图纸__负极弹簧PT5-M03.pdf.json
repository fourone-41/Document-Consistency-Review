  "semantic_fragments": [
    {
      "fragment_type": "constraint_statement",
      "content": "与正极的区别：负极未声明可上锡焊接（正极弹簧技要第 6 条明确\"上锡型接\"，负极无此条）。负极亦未声明弹力 ≥0.5 kgf @5 mm 压缩要求（正极弹簧技要第 5 条有此要求，负极无此条）。",
      "topic_tags": [
        "负极弹簧",
        "焊接",
        "弹力",
        "与正极差异"
      ],
      "related_subjects": [
        "PT5-M02",
        "PT5-M03"
      ]
    },
    {
      "fragment_type": "design_rationale",
      "content": "负极弹簧 PT5-M03 与正极弹簧 PT5-M02 几何差异对照：线径 Ø 0.50±0.03 相同；外径 Ø 6.50±0.10 相同；自由高 11.7 相同；总圈数负极明示 N=4±0.25，正极未明示；工作段长正极 7.0±0.30，负极未明示；螺距正极 2.30，负极未明示；正极有挂钩 Z 形 90° 弯折，负极无明示 90°；挂钩展开宽正极 5.3，负极 5.4，差 0.1 mm；盐雾标准正极 GB2423.17-2008 5%/35°/24H，负极内层 ≥8.5%/24H。",
      "topic_tags": [
        "正负极弹簧对比",
        "几何差异",
        "PT5-M02",
        "PT5-M03"
      ],
      "related_subjects": [
        "PT5-M02",
        "PT5-M03",
        "PT5 耳温计",
        "PT9L"
      ]
    },
    {
      "fragment_type": "scope_limitation",
      "content": "PT5-M03 负极弹簧为 PT5 耳温计与 PT9L 共用件，设计日期 2019-07-15，PT9L 项目沿用。关联文件：正极弹簧 PT5-M02、PT3 双联弹簧 REV01、wiki/drawings/pt9l-drawings.md §2.4。",
      "topic_tags": [
        "共用件",
        "PT5",
        "PT9L",
        "关联文件"
      ],
      "related_subjects": [
        "PT5-M02",
        "PT3双联弹簧REV01",
        "pt9l-drawings.md"
      ]
    },
    {
      "fragment_type": "behavioral_spec",
      "content": "自动校验结果：DPI 检查 overview 150 + blocks 300 通过；编号连续性 ① ② 完整通过；公差形式 ±0.03 / ±0.1 / ±0.25（总圈数）均对称通过；Φ ↔ ① 视觉确认：① 0.5 线径径向引出 Ø 通过，② 6.5 径向引出 Ø 通过；与正极几何对照：自由高 / 线径 / 外径全同；挂钩中末段同；唯挂钩展开宽 5.4 vs 5.3（差 0.1 mm，可能为挂钩形状细节差异）。",
      "topic_tags": [
        "自动校验",
        "DPI",
        "尺寸确认",
        "公差"
      ],
