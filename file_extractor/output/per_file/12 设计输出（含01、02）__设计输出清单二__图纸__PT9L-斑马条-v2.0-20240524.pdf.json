  "semantic_fragments": [
    {
      "fragment_type": "working_principle",
      "content": "斑马条（Zebra Strip / Elastomeric Connector）= 由导电硅胶（金/银粉填充）与绝缘硅胶交替条纹层叠而成的弹性连接器，专用于 LCD 段码屏与 PCBA 之间的无焊接电气连接。导电方向为垂直于长度方向（即沿厚度方向），电流从 LCD PIN 沿厚度方向传到 PCBA 焊盘，不沿长度方向短路。装配时被 LCD 与 PCBA 之间的弹性压缩力（推测 10-20% 压缩量）压紧，导电硅胶层与 LCD PIN + PCBA 焊盘做面接触。",
      "topic_tags": [
        "斑马条",
        "导电硅胶",
        "工作原理",
        "弹性连接器",
        "LCD",
        "PCBA",
        "无焊接连接"
      ],
      "related_subjects": [
        "PT9L-液晶（PT9L-L01）",
        "PCBA",
        "T-Z1-P12"
      ]
    },
    {
      "fragment_type": "behavioral_spec",
      "content": "装配配合关系：顶部与 PT9L-液晶-20240627 顶部 16 个 PIN（间距 1.0 mm，总长 15.00 mm）接触；底部与 PCBA 上 16 个对应焊盘接触；被上下盖或专用支架/卡扣压紧到固定压缩量。斑马条长度 22 mm > LCD PIN 阵列 15 mm，留有装配偏移容差 (22−15)/2 = 3.5 mm（每边）。",
      "topic_tags": [
        "装配配合",
        "LCD PIN",
        "PCBA焊盘",
        "压缩量",
        "容差",
        "16PIN"
      ],
      "related_subjects": [
        "PT9L-液晶（PT9L-L01）",
        "PCBA",
        "斑马条"
      ]
    },
    {
      "fragment_type": "constraint_statement",
      "content": "自动检查结果：DPI 300；编号 ① ② ③ 共 3 个，连续无跳号；无角度；无 n- 前缀；全对称 ±0.1 公差；配合方为 PT9L 液晶（PT9L-L01），液晶 SPEC 表 CONNECTOR TYPE = ZEBRA，同时与 PCBA 上对应 16 个焊盘配合（位置间距对齐 LCD PIN 1.0 mm 间距）；全部为长度/宽度尺寸，无 Φ。",
      "topic_tags": [
        "质量检查",
        "IQC",
        "配合验证",
        "公差",
        "连续性"
      ],
