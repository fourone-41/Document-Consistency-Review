    {
      "test_id": "PT9L-BLTR01",
      "item": "电池使用寿命测试（动态功耗）",
      "condition": "温度22℃；湿度55%；两节七号干电池（3V/1000mAh）供电；串入万用表电流档；模拟一次用户测量过程，从按键唤醒到自动进入待机",
      "expected_value": "满足设计输入要求",
      "actual_result": "平均动态功耗12.7mA，连续工作时间=1000mAh*0.6/12.7mA=47.24h",
      "pass_criteria": "满足设计输入的要求",
      "instrument": "万用表（电流档）",
      "environment": "温度22℃；湿度55%"
    },
    {
      "test_id": "PT9L-BLTR01",
      "item": "电池使用寿命测试（静态功耗）",
      "condition": "温度22℃；湿度55%；两节七号干电池（3V/1000mAh）供电；串入万用表电流档；模拟一次用户测量过程，从按键唤醒到自动进入待机后开始测量",
      "expected_value": "满足设计输入要求",
      "actual_result": "平均静态功耗8.1uA，待机时间=1000mAh*1000*0.6/8.1uA/24/30=102.88月",
      "pass_criteria": "满足设计输入要求",
      "instrument": "万用表（电流档）",
      "environment": "温度22℃；湿度55%"
    }
  ],
