  "semantic_fragments": [
    {
      "fragment_type": "working_principle",
      "content": "用户测量流程：单片机ADC采集外部NTC、红外传感器的环境温度和物体温度，当环境温度在允许测量范围以内，采集红外传感器的温度值并优化，通过环境温度值和物体温度值计算出人体实际的温度值。",
      "topic_tags": [
        "用户测量流程",
        "ADC采集",
        "NTC",
        "红外传感器",
        "体温计算"
      ],
      "related_subjects": [
        "测量功能",
        "红外传感器接口",
        "NTC采样"
      ]
    },
    {
      "fragment_type": "working_principle",
      "content": "黑体测试流程：单片机ADC采集红外传感器的环境温度和物体温度，并通过补偿算法得出黑体的温度（不转化为人体体温）并进行显示。本模式用于检查机器能否测得正确的物体温度。",
      "topic_tags": [
        "黑体测试",
        "补偿算法",
        "ADC采集",
        "红外传感器"
      ],
      "related_subjects": [
        "测量功能",
        "红外传感器接口"
      ]
    },
    {
      "fragment_type": "working_principle",
      "content": "UE模式：UE模式下对传感器的值进行实时读取与显示，包括电池电压、内部NTC的温度值、阻值、红外传感器电压、AD值，按下按键，切换采集的参数。",
      "topic_tags": [
        "UE模式",
        "传感器实时读取",
        "NTC",
        "红外传感器",
        "电池电压"
      ],
      "related_subjects": [
        "NTC采样",
        "电池电量采集",
        "红外传感器接口"
      ]
    },
    {
      "fragment_type": "working_principle",
      "content": "UE2模式：UE2模式下，单片机读取EEPROM中保存的标定和校准参数，以及软件版本信息和硬件版本信息，并进行显示。按下按键，切换显示的参数。",
      "topic_tags": [
        "UE2模式",
        "EEPROM",
        "标定参数",
        "校准参数",
        "版本信息"
      ],
      "related_subjects": [
        "初始化功能",
        "记忆功能"
      ]
    },
    {
      "fragment_type": "working_principle",
      "content": "邦定检测：为工厂对机芯进行检测的状态，在该状态下能够对单片机的IO邦定、电路板元器件的焊接进行检测，在检测完成后，相应标志位进行设置并保存入EEPROM。",
      "topic_tags": [
        "邦定检测",
        "工厂检测",
        "IO检测",
        "焊接检测",
        "EEPROM"
      ],
      "related_subjects": [
        "初始化功能"
      ]
    },
    {
      "fragment_type": "design_rationale",
      "content": "软、硬件接口方案：按键 Pin45、Pin40；蜂鸣器 Pin38；LCD显示 Pin8~Pin25；红外传感器接口 Pin3、Pin4；LCD背光驱动接口 Pin35、Pin36、Pin39；NTC采样 Pin42；电池电量采集 Pin41；静音开关接口 Pin44。",
      "topic_tags": [
        "硬件接口",
        "引脚配置",
        "按键",
        "蜂鸣器",
        "LCD",
        "红外传感器",
        "NTC",
        "电池"
      ],
      "related_subjects": [
        "测量功能",
        "LCD显示功能",
        "蜂鸣器提示功能",
        "低电压检测功能"
      ]
    },
    {
      "fragment_type": "constraint_statement",
      "content": "降低风险的措施方案：1）显示信息不明确——危害处境：患者、操作者将显示的信息理解错误——措施方案：软件对显示功能做测试，说明书解释显示的信息；2）不正确的算法——危害处境：患者、操作者使用了算法不正确的设备——措施方案：软件发布前进行算法验证；3）不正确的测试结果存储（包括结果分组和时间的对应）——危害处境：患者、操作者查询错误的记忆值——措施方案：软件对记忆功能做测试。",
      "topic_tags": [
        "风险措施",
        "危害分析",
        "显示功能",
        "算法验证",
        "记忆功能"
      ],
      "related_subjects": [
        "LCD显示功能",
        "测量功能",
        "记忆功能",
        "错误显示功能"
      ]
    }
  ],
