  "software_items": [
    {
      "item_type": "软件运行环境",
      "name": "单片机系统",
      "description": "软件的预期运行环境",
      "value": "simBH67F2762",
      "run_environment": "单片机系统 simBH67F2762"
    }
  ],
  "functions": [
    {
      "name": "初始化功能",
      "description": "首次上电或被唤醒后，初始化全局变量、IO、时钟，LCD；MCU系统功能初始化，配置相关模块和功能设置，读取EEPROM存储信息"
    },
    {
      "name": "关机功能",
      "description": "当完成测量后，启动定时器计时，当达15秒后关闭外设，同时单片机进入低功耗状态；期间如果有测量动作则重新计时。模式设置界面，设置完成后，没有按键按下，机器会在3秒后自动关机"
    },
    {
      "name": "LCD显示功能",
      "description": "首次上电后，LCD全屏显示3秒；测量完成后，LCD显示测量温度结果、单位、电量等信息；结合测试结果给出发烧提示，用背光颜色区分"
    },
    {
      "name": "蜂鸣器提示功能",
      "description": "在首次上电时，蜂鸣器长鸣；LCD显示测量结果时，成功长鸣，发烧连续四次短鸣；模式设置界面，选择时短鸣，确认后长鸣"
    },
    {
      "name": "低电压检测功能",
      "description": "如果电源电压2.5V–2.7V时，LCD能提示低电压并保存低电状态，直至下次重新上电后再检测；如果电源电压小于2.5V时，LCD提示超低电压后关机，一直保存此状态，直至下次重新上电后再检测"
    },
    {
      "name": "测量模式设置功能",
      "description": "在开机状态下，短按设置按键，切换测量模式；按下测量按键，保存当前模式，并完成一次测量；选择完成后，15s没有操作，进入关机状态"
    },
    {
      "name": "单位切换功能",
      "description": "长按测量按键8秒后，出现单位图标闪烁，短按测量按键切换单位，选好后长按2秒，图标停止闪烁，3秒后关机；如果进入设置后无按键操作，15秒关机"
    },
    {
      "name": "测量功能",
      "description": "单片机检测到按键按下后，单片机读取ADC采集数据；在深度测量模式下，单片机连续读取ADC采集数据，直到测量时间结束，通过计算得出温度值，在屏幕显示结果，并且蜂鸣器提示"
    },
    {
      "name": "错误显示功能",
      "description": "当环境温度超出10~40℃，LCD闪烁显示\"Err\"；测温大于42.9℃，或小于32℃提示\"---℃\"，不显示结果"
    },
    {
      "name": "记忆功能",
      "description": "每次测量成功，把数据保存到EEPROM，同时也保存测量模式等信息；长按设置按键3秒进入记忆查看模式，且只能查看之前测量模式下对应的记忆数据，如果想查看其他模式记忆，需要退出记忆后切换测量模式再查看；关机状态下，同时长按测量键和设置键8秒，可清空记忆"
    }
  ],
