  "semantic_fragments": [
    {
      "fragment_type": "design_rationale",
      "content": "硬件设计方案核心参数汇总：电源采用2×AAA电池供电，输入电压2.6-3V，通过升压芯片SR1833升压至3.3V输出，输出电流评估150mA，输入端配置100uF滤波电容，输出端配置10uF滤波电容；防反接采用自恢复保险和二极管；低电检测通过MCU的PA1端口以A/D方式采集电池电压。传感器为温度传感器，连接至MCU的AN0~AN3端口进行模拟电压采样。LCD显示屏1个，SEG口12个，COM口4个，配备三色背光灯。MCU时钟晶振与主晶振均为芯片内置，无外部存储器，复位电容100nF，配备2个机械按键，程序烧写使用合泰官方烧写器。振动电机规格DC 3V、转速12000rpm（标注为不适用）。",
      "topic_tags": [
        "硬件设计",
        "电源设计",
        "传感器",
        "LCD",
        "MCU",
        "红外体温计"
      ],
      "related_subjects": [
        "PT9L",
        "红外体温计",
        "项目编号30000078"
      ]
    }
