  "semantic_fragments": [
    {
      "fragment_type": "scope_limitation",
      "content": "评审内容：\n1. 评审是否按照设计确认计划进行了设计确认活动；\n2. 评审设计确认报告；\n3. 评审是否有遗留的预期用途内容未被确认。",
      "topic_tags": [
        "设计确认",
        "评审内容",
        "确认计划",
        "确认报告"
      ],
      "related_subjects": [
        "设计确认报告",
        "设计确认计划"
      ]
    },
    {
      "fragment_type": "constraint_statement",
      "content": "接收准则：如果设计确认内容能够证明：设计规格（或设计输出）与产品预期用途一致，评审通过，否则不通过。",
      "topic_tags": [
        "接收准则",
        "设计确认",
        "预期用途",
        "设计输出"
      ],
      "related_subjects": [
        "设计规格",
        "设计输出",
        "预期用途"
      ]
    },
    {
      "fragment_type": "behavioral_spec",
      "content": "人员职责：\n技术负责人：从产品的相关视角评审确认活动的正确性、完整性；\n项目负责人：组织设计确认评审，并形成评审记录；\n结构主管：结构相关确认的审核与评审；\n硬件主管：硬件相关确认的审核与评审；\n软件主管：软件相关确认的审核与评审；\n客户代表：从客户的视角评审确认活动的正确性、完整性；\n具有医学背景人员：从医护的视角评审确认活动的正确性、完整性；\n对本阶段不负直接责任的人员：从不同的视角评审确认活动的正确性、完整性，以保持评审的独立性；\n认证工程师：从产品认证和风险的角度评审确认活动的正确性、完整性。",
      "topic_tags": [
        "人员职责",
        "评审分工",
        "设计确认评审"
      ],
      "related_subjects": [
        "侯广伟",
        "王迪龙",
        "高克俭",
        "赵一平",
        "王艳红"
      ]
    }
  ],
