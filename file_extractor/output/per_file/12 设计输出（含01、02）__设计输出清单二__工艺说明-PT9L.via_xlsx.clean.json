  "plan_tasks": [
    {
      "task_name": "探头组装",
      "process_group": "组装探头板",
      "priority": "关键工序",
      "purpose": "压合传感器",
      "equipment": [
        "传感器冲压模具",
        "气动压力机"
      ],
      "steps": [
        "左手持1PCS温度传感器，右手使用偏口钳将传感器凸点减掉",
        "将温度传感器装入散热金属套",
        "将散热金属套装入压块",
        "将安装好的探头装入传感器压合工装内",
        "盖上传感器压合工装上盖",
        "将压合工装放置气动压合工装指定位置",
        "双手同时压下气动压合工装上的两个按钮",
        "取出压合完成的传感器"
      ]
    },
    {
      "task_name": "涂抹硅脂",
      "process_group": "组装探头板",
      "priority": "关键工序",
      "purpose": "使传感器导热均匀",
      "equipment": [
        "自动涂硅脂机"
      ],
      "steps": [
        "把组装好的探头放入自动涂硅脂机，由机器自动涂抹硅脂"
      ]
    },
    {
      "task_name": "焊探头到PCB",
      "process_group": "组装探头板",
      "priority": "关键工序",
      "purpose": "焊温度传感器板",
      "equipment": [
        "焊锡（无铅，符合ROHS）",
        "恒温电烙铁"
      ],
      "steps": [
        "把涂抹好硅脂的传感器探头插入传感器板，探头金脚插入传感器板的4脚位置",
        "焊探头脚到PCB上",
        "剪脚"
      ]
    },
    {
      "task_name": "导线焊到探头板上",
      "process_group": "探头板焊线",
      "priority": "重要",
      "purpose": "导线焊到探头板上",
      "equipment": [
        "焊锡（无铅，符合ROHS）",
        "恒温电烙铁"
      ],
      "steps": [
        "依次将红、白、黑线焊接到相应标识位置上"
      ]
    },
    {
      "task_name": "探头支架组装",
      "process_group": "组装探头支架",
      "priority": "重要",
      "purpose": "组装探头支架",
      "equipment": [
        "电动螺丝起子（扭力要求：1.8±0.2kgf.cm）"
      ],
      "steps": [
        "将焊接完成的探头装入支架内",
        "将装有探头的支架放置在工装治具内",
        "将螺钉打入PCB螺钉定位孔内"
      ]
    },
    {
      "task_name": "探头涂三防漆",
      "process_group": "涂三防漆",
      "priority": "重要",
      "purpose": "探头涂三防漆",
      "equipment": [
        "毛刷",
        "三防漆"
      ],
      "steps": [
        "使用毛刷将传感器板表面涂抹三防漆"
      ]
    },
    {
      "task_name": "贴片",
      "process_group": "SMT",
      "priority": "关键工序",
      "purpose": "贴片元器件",
      "steps": [
        "主板SMT加工参考PT9L-SMTW01（按照最新版本执行）",
        "元件使用参考PT9L-EBOM01（按照最新版本执行）"
      ]
    },
    {
      "task_name": "主板程序烧写",
      "process_group": "烧写",
      "priority": "关键工序",
      "purpose": "主板程序烧写",
      "equipment": [
        "PT9L烧写工装PT9L-SHAOXIE",
        "合泰Gang-Writer8-8烧写器",
        "静电手腕带"
      ],
      "steps": [
        "参考PT9L工装操作说明PT9L-GZSM01（按照最新版本执行）"
      ]
    },
    {
      "task_name": "主板贴片检测",
      "process_group": "检测",
      "priority": "关键工序",
      "purpose": "检测贴片的元件功能、性能、虚焊、连焊",
      "equipment": [
        "PT9L检测工装PT9L-CESHI",
        "电源（输出电压3±0.1V，最大输出电流500mA，电流指示精度0.01mA）",
        "静电手腕带"
      ],
      "steps": [
        "上电后两个LED灯D1和D2全亮，屏幕显示CB1，然后显示软件版本号，2s后进入休眠，两个LED灯熄灭，显示黑屏，操作人员查看休眠电流",
        "按下按键S1唤醒，两个LED点亮，LCD全显",
        "若自检全部通过，LCD显示PAS，按下按键S1保存，CB1完成",
        "若自检未通过，屏幕显示Er1"
      ]
    },
    {
      "task_name": "在主板上焊接蜂鸣器",
      "process_group": "焊接",
      "priority": "重要",
      "purpose": "往主板上焊接蜂鸣器",
      "equipment": [
        "焊锡（无铅，符合ROHS）",
        "恒温电烙铁"
      ],
      "steps": [
        "将蜂鸣器放置在工装制具内",
        "将PCB放置工装内，使蜂鸣器两个管脚穿过PCB BUZZER位置的两个过孔",
        "将蜂鸣器与PCB焊接在一起"
      ]
    },
    {
      "task_name": "在主板上焊接电池正负极弹簧",
      "process_group": "焊接",
      "priority": "重要",
      "purpose": "在主板上焊接电池正负极弹簧",
      "equipment": [
        "焊锡（无铅，符合ROHS）",
        "恒温电烙铁"
      ],
      "steps": [
        "将正负极簧放置在工装制具内",
        "将PCB放置工装内，使正负极簧两个管脚分别穿过PCB +、- 位置的过孔",
        "将正负极簧与PCB焊接在一起"
      ]
    },
    {
      "task_name": "连接主板和传感器探头组件",
      "process_group": "焊接",
      "priority": "重要",
      "purpose": "连接主板和传感器探头组件",
      "equipment": [
        "焊锡（无铅，符合ROHS）",
        "恒温电烙铁"
      ],
      "steps": [
        "焊接在主板PCB上SENSOR位置",
        "焊接温度不超过380℃，时间不超过3秒",
        "SENSOR的1、2、3焊盘分别对应红、白、黑色导线"
      ]
    },
    {
      "task_name": "进入装配工序",
      "process_group": "装配",
      "priority": "重要",
      "reference": "PT9L装配说明 PT9L-ZPSM01（按照最新版本执行）"
    },
    {
      "task_name": "整机检验",
      "process_group": "整机检验",
      "priority": "重要",
      "reference": "PT9L装配说明 PT9L-ZPSM01（按照最新版本执行）"
    },
    {
      "task_name": "进入包装工序",
      "process_group": "包装",
      "priority": "重要",
      "reference": "PT9L装配说明 PT9L-ZPSM01（按照最新版本执行）"
    },
    {
      "task_name": "出货检验",
      "process_group": "出货检验",
      "priority": "重要",
      "reference": "PT9L产品检验标准 PT9L-JYBZ01（按照最新版本执行）"
    }
  ],
  "requirements": [
    {
      "req_id": "REQ-探头组装-01",
      "source_process": "探头组装",
      "description": "不得用手触摸传感器镜片"
    },
    {
      "req_id": "REQ-探头组装-02",
      "source_process": "探头组装",
      "description": "剪点到位"
    },
    {
      "req_id": "REQ-探头组装-03",
      "source_process": "探头组装",
      "description": "外观无破损、脏污等不良"
    },
    {
      "req_id": "REQ-探头组装-04",
      "source_process": "探头组装",
      "description": "压合后高度：14.1±0.1mm"
    },
    {
      "req_id": "REQ-探头组装-05",
      "source_process": "探头组装",
      "description": "传感器、散热套无松动现象"
    },
    {
      "req_id": "REQ-探头组装-06",
      "source_process": "探头组装",
      "description": "设备压力调节0.6±0.05MPa，时间调节在3±1秒"
    },
    {
      "req_id": "REQ-涂硅脂-01",
      "source_process": "涂抹硅脂",
      "description": "涂抹均匀，不得涂抹到传感器脚"
    },
    {
      "req_id": "REQ-焊探头PCB-01",
      "source_process": "焊探头到PCB",
      "description": "插装到位；焊点饱满圆润，无漏焊、虚焊、脱焊、立碑、桥接、拉尖等不良缺陷"
    },
    {
      "req_id": "REQ-焊线-01",
      "source_process": "导线焊到探头板上",
      "description": "红线焊在PCB丝印1位置；白线焊在PCB丝印2位置；黑线焊在PCB丝印3位置"
    },
    {
      "req_id": "REQ-探头支架-01",
      "source_process": "探头支架组装",
      "description": "检验探头焊点，无虚焊、漏焊、连焊现象；探头放置平稳无虚位、晃动现象；螺钉安装到位"
    },
    {
      "req_id": "REQ-三防漆-01",
      "source_process": "探头涂三防漆",
      "description": "三防漆涂抹均匀，不得粘连到其他部件；三防漆涂抹必须完全覆盖传感器的四个焊点"
    },
    {
      "req_id": "REQ-SMT-01",
      "source_process": "贴片",
      "description": "焊接元器件正确，PCB板上相应贴片元件需与BOM中元器件名称规格一一对应，带极性元器件焊接方向正确"
    },
    {
      "req_id": "REQ-SMT-02",
      "source_process": "贴片",
      "description": "元器件不能有缺口、破裂和烫伤，元器件焊接高度不影响装配，PCB板不能有破损、变形、翘曲，表面清洁、无焊料小圆球"
    },
    {
      "req_id": "REQ-SMT-03",
      "source_process": "贴片",
      "description": "焊点要表面润湿、完整、连续和圆滑，焊料量适中，焊点位置准确，无漏焊、虚焊、脱焊、立碑、桥接、拉尖等不良缺陷"
    },
    {
      "req_id": "REQ-检测-01",
      "source_process": "主板贴片检测",
      "description": "休眠电流应小于30uA"
    },
    {
      "req_id": "REQ-检测-02",
      "source_process": "主板贴片检测",
      "description": "电池电压在2.7V到3.3V之间"
    },
    {
      "req_id": "REQ-检测-03",
      "source_process": "主板贴片检测",
      "description": "外部NTC温度在23℃到27℃之间（此处为10K的标准电阻）"
    },
    {
      "req_id": "REQ-检测-04",
      "source_process": "主板贴片检测",
      "description": "红外传感器测温应在10℃到40℃之间"
    },
    {
      "req_id": "REQ-蜂鸣器焊接-01",
      "source_process": "在主板上焊接蜂鸣器",
      "description": "放置平稳；蜂鸣器本体紧贴PCB；焊点圆滑饱满，不可出现拉尖、连焊、虚焊、漏焊"
    },
    {
      "req_id": "REQ-电池弹簧-01",
      "source_process": "在主板上焊接电池正负极弹簧",
      "description": "放置平稳；正负极簧本体紧贴PCB；焊点圆滑饱满，不可出现拉尖、连焊、虚焊、漏焊"
    },
    {
      "req_id": "REQ-SENSOR连接-01",
      "source_process": "连接主板和传感器探头组件",
      "description": "焊点圆滑饱满，不可出现拉尖、连焊、虚焊、漏焊，高度不超过3.0mm"
    },
    {
      "req_id": "REQ-SENSOR连接-02",
      "source_process": "连接主板和传感器探头组件",
      "description": "焊点强度垂直拉力要求在100N以上"
    },
    {
      "req_id": "REQ-SENSOR连接-03",
      "source_process": "连接主板和传感器探头组件",
      "description": "焊接温度不超过380℃，时间不超过3秒"
    }
  ],
