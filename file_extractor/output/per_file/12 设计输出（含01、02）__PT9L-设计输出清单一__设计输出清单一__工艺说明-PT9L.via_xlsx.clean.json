  "plan_tasks": [
    {
      "task_name": "探头组装",
      "process": "组装探头板",
      "level": "关键工序",
      "purpose": "压合传感器",
      "equipment": [
        "传感器冲压模具",
        "气动压力机"
      ],
      "instructions": "1.左手持1PCS温度传感器，右手使用偏口钳将传感器凸点减掉；2、将温度传感器装入散热金属套；3、将散热金属套，装入压块；4、将安装好的探头，装入传感器压合工装内；5、盖上传感器压合工装上盖；6、将压合工装放置气动压合工装指定位置；7、双手同时压下气动压合工装上的两个按钮；8、取出压合完成的传感器。",
      "inspection_requirements": [
        "不得用手触摸传感器镜片",
        "剪点到位",
        "外观无破损、脏污等不良",
        "拿取传感器时，不得抓取传感器腿，以免造成传感器腿粘连、弯曲影响传感器板装配",
        "探头放置平稳",
        "压合后高度：14.1±0.1mm",
        "传感器、散热套无松动现象",
        "设备压力调节0.6±0.05MPa，时间调节在3±1秒"
      ]
    },
    {
      "task_name": "涂抹硅脂",
      "process": "组装探头板",
      "level": "关键工序",
      "purpose": "使传感器导热均匀",
      "equipment": [
        "自动涂硅脂机"
      ],
      "instructions": "把组装好的探头放入自动涂硅脂机，由机器自动涂抹硅脂",
      "inspection_requirements": [
        "涂抹均匀，不得涂抹到传感器脚"
      ]
    },
    {
      "task_name": "焊探头到PCB",
      "process": "组装探头板",
      "level": "关键工序",
      "purpose": "焊温度传感器板",
      "equipment": [
        "焊锡：无铅，符合ROHS",
        "恒温电烙铁：最高温度满足元器件焊接温度"
      ],
      "instructions": "1、把涂抹好硅脂的传感器探头插入传感器板，探头金脚插入传感器板的4脚位置；2、焊探头脚到PCB上；3、剪脚。",
      "inspection_requirements": [
        "插装到位",
        "焊点饱满圆润，无漏焊、虚焊、脱焊、立碑、桥接、拉尖等不良缺陷"
      ]
    },
    {
      "task_name": "导线焊到探头板上",
      "process": "探头板焊线",
      "level": "重要",
      "purpose": "导线焊到探头板上",
      "equipment": [
        "焊锡：无铅，符合ROHS",
        "恒温电烙铁：最高温度满足元器件焊接温度"
      ],
      "instructions": "依次将红、白、黑线焊接到相应标识位置上。",
      "inspection_requirements": [
        "红线焊在PCB丝印\"1\"位置",
        "白线焊在PCB丝印\"2\"位置",
        "黑线焊在PCB丝印\"3\"位置"
      ]
    },
    {
      "task_name": "探头支架组装",
      "process": "组装探头支架",
      "level": "重要",
      "purpose": "组装探头支架",
      "equipment": [
        "电动螺丝起子，扭力要求：1.8±0.2kgf.cm"
      ],
      "instructions": "1、将焊接完成的探头装入支架内；2、将装有探头的支架放置在工装治具内；3、将螺钉打入PCB螺钉定位孔内。",
      "inspection_requirements": [
        "检验探头焊点，无虚焊、漏焊、连焊现象",
        "探头放置平稳无虚位，晃动现象",
        "螺钉安装到位"
      ]
    },
