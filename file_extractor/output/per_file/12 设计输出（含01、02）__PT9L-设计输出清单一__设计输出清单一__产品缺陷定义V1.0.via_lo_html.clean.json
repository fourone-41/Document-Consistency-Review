  "functions": [
    {
      "name": "正常测量",
      "description": "产品每次测温时，如果目标温度正常，显示所测温度，同时显示相对应的颜色，蜂鸣器长鸣0.5S，若测量错误，显示三条杠和温度单位，蜂鸣器短鸣3次。"
    },
    {
      "name": "自检",
      "description": "将产品断电后（无余电），重新上电进入上电模式，产品自检正常：显示屏全显且白色背光亮，检查LCD显示内容是否正确，是否有乱显、多显、少显现象，同时蜂鸣器长鸣0.5S，3S后进入待机模式。若自检故障，屏幕全亮且闪烁。"
    },
    {
      "name": "测量范围",
      "description": "32℃～42.9℃，范围内任意温度均可以测量出数值。超出测量范围，机器应当报错。"
    },
    {
      "name": "测量精度",
      "description": "≥35℃且≤42℃：±0.2℃，其它±0.3℃。"
    },
    {
      "name": "自动关机",
      "description": "测温后无操作15S自动关机。"
    },
    {
      "name": "电流消耗",
      "description": "测量模式耗电电流：平均值须小于50mA；待机电流：平均值须小于20uA。"
    },
    {
      "name": "短路测试",
      "description": "将电池装反或将装在电池盒内的电池短路，不可有明火或冒烟现象。"
    },
    {
      "name": "低电压检测",
      "description": "1、使用直流电源供电，将供电电压调至2.7V时，测量完毕后LCD显示电池符号；2、继续将供电电压调至DC 2.5V时，LCD应显示低电压图标且闪烁15S后产品关机。"
    }
  ],
