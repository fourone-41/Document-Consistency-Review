      "level": "重要"
    },
    {
      "id": "REQ-连接传感器-02",
      "description": "焊点强度垂直拉力要求在100N以上",
      "process": "连接主板和传感器探头组件",
      "level": "重要"
    },
    {
      "id": "REQ-连接传感器-03",
      "description": "焊接温度不超过380℃，时间不超过3秒",
