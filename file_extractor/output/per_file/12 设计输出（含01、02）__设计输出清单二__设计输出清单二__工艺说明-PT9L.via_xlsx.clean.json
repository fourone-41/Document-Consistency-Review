  "plan_tasks": [
    {
      "task_name": "探头组装",
      "process_stage": "组装探头板",
      "level": "关键工序",
      "purpose": "压合传感器",
      "equipment": [
        "传感器冲压模具",
        "气动压力机"
      ],
      "steps": [
        "左手持1PCS温度传感器，右手使用偏口钳将传感器凸点减掉",
        "将温度传感器装入散热金属套",
        "将散热金属套装入压块",
        "将安装好的探头装入传感器压合工装内",
        "盖上传感器压合工装上盖",
        "将压合工装放置气动压合工装指定位置",
        "双手同时压下气动压合工装上的两个按钮",
        "取出压合完成的传感器"
      ]
    },
    {
      "task_name": "涂抹硅脂",
      "process_stage": "组装探头板",
      "level": "关键工序",
      "purpose": "使传感器导热均匀",
      "equipment": [
        "自动涂硅脂机"
      ],
      "steps": [
        "把组装好的探头放入自动涂硅脂机，由机器自动涂抹硅脂"
      ]
    },
    {
      "task_name": "焊探头到PCB",
      "process_stage": "组装探头板",
      "level": "关键工序",
      "purpose": "焊温度传感器板",
      "equipment": [
        "无铅焊锡（符合ROHS）",
        "恒温电烙铁"
      ],
      "steps": [
        "把涂抹好硅脂的传感器探头插入传感器板，探头金脚插入传感器板的4脚位置",
        "焊探头脚到PCB上",
        "剪脚"
      ]
    },
    {
      "task_name": "导线焊到探头板上",
      "process_stage": "探头板焊线",
      "level": "重要",
      "purpose": "导线焊到探头板上",
      "equipment": [
        "无铅焊锡（符合ROHS）",
        "恒温电烙铁"
      ],
      "steps": [
        "依次将红、白、黑线焊接到相应标识位置上"
      ]
    },
    {
      "task_name": "探头支架组装",
      "process_stage": "组装探头支架",
      "level": "重要",
      "purpose": "组装探头支架",
      "equipment": [
        "电动螺丝起子，扭力要求：1.8±0.2kgf.cm"
      ],
      "steps": [
        "将焊接完成的探头装入支架内",
        "将装有探头的支架放置在工装治具内",
        "将螺钉打入PCB螺钉定位孔内"
      ]
    },
    {
      "task_name": "探头涂三防漆",
      "process_stage": "涂三防漆",
      "level": "重要",
      "purpose": "探头涂三防漆",
      "equipment": [
        "毛刷",
        "三防漆"
      ],
      "steps": [
        "使用毛刷将传感器板表面涂抹三防漆"
      ]
    },
    {
      "task_name": "贴片",
      "process_stage": "SMT",
      "level": "关键工序",
      "purpose": "贴片元器件",
      "references": [
        "PT9L SMT加工说明 PT9L-SMTW01（按照最新版本执行）",
        "PT9L机芯类组件清单 PT9L-EBOM01（按照最新版本执行）"
      ]
    },
    {
      "task_name": "主板程序烧写",
      "process_stage": "烧写",
      "level": "关键工序",
      "purpose": "主板程序烧写",
      "equipment": [
        "PT9L烧写工装 PT9L-SHAOXIE",
        "合泰Gang-Writer8-8烧写器",
        "静电手腕带"
      ],
      "references": [
        "PT9L工装操作说明 PT9L-GZSM01（按照最新版本执行）"
      ]
    },
    {
      "task_name": "主板贴片检测",
      "process_stage": "检测",
      "level": "关键工序",
      "purpose": "检测贴片的元件功能、性能、虚焊、连焊",
      "equipment": [
        "PT9L检测工装 PT9L-CESHI",
        "电源（输出电压3±0.1V，最大输出电流500mA，电流指示精度0.01mA）",
        "静电手腕带"
      ],
      "steps": [
        "上电后两个LED灯D1和D2全亮，屏幕显示CB1，然后显示软件版本号，2s后进入休眠，两个LED灯熄灭，显示黑屏，操作人员查看休眠电流，应小于30uA",
        "按下按键S1唤醒，两个LED点亮，LCD全显",
        "若自检全部通过，LCD显示\"PAS\"，按下按键S1保存，CB1完成",
        "若自检未通过，屏幕显示Er1"
      ]
    },
    {
      "task_name": "在主板上焊接蜂鸣器",
      "process_stage": "焊接",
      "level": "重要",
      "purpose": "往主板上焊接蜂鸣器",
      "equipment": [
        "无铅焊锡（符合ROHS）",
        "恒温电烙铁"
      ],
      "steps": [
        "将蜂鸣器放置在工装制具内",
        "将PCB放置工装内，使蜂鸣器两个管脚穿过PCB\"BUZZER\"位置的两个过孔",
        "将蜂鸣器与PCB焊接在一起"
      ]
    },
    {
      "task_name": "在主板上焊接电池正负极弹簧",
      "process_stage": "焊接",
      "level": "重要",
      "purpose": "在主板上焊接电池正负极弹簧",
      "equipment": [
        "无铅焊锡（符合ROHS）",
        "恒温电烙铁"
      ],
      "steps": [
        "将正负极簧放置在工装制具内",
        "将PCB放置工装内，使正负极簧两个管脚分别穿过PCB\"+\"\"-\"位置的过孔",
        "将正负极簧与PCB焊接在一起"
      ]
    },
    {
      "task_name": "连接主板和传感器探头组件",
      "process_stage": "焊接",
      "level": "重要",
      "purpose": "连接主板和传感器探头组件",
      "equipment": [
        "无铅焊锡（符合ROHS）",
        "恒温电烙铁"
      ],
      "steps": [
        "焊接在主板PCB上SENSOR位置",
        "焊接温度不超过380℃，时间不超过3秒",
        "SENSOR的\"1、2、3\"焊盘分别对应红、白、黑色导线"
      ]
    },
    {
      "task_name": "进入装配工序",
      "process_stage": "装配",
      "level": "重要",
      "references": [
        "PT9L装配说明 PT9L-ZPSM01（按照最新版本执行）"
      ]
    },
    {
      "task_name": "整机检验",
      "process_stage": "整机检验",
      "level": "重要",
      "references": [
        "PT9L装配说明 PT9L-ZPSM01（按照最新版本执行）"
      ]
    },
    {
      "task_name": "进入包装工序",
      "process_stage": "包装",
      "level": "重要",
      "references": [
        "PT9L装配说明 PT9L-ZPSM01（按照最新版本执行）"
      ]
    },
    {
      "task_name": "出货检验",
      "process_stage": "出货检验",
      "level": "重要",
      "references": [
        "PT9L产品检验标准 PT9L-JYBZ01（按照最新版本执行）"
      ]
    }
  ],
  "requirements": [
    {
      "id": "REQ-探头组装-01",
      "description": "不得用手触摸传感器镜片",
      "process": "探头组装",
      "level": "关键工序"
    },
    {
      "id": "REQ-探头组装-02",
      "description": "剪点到位",
      "process": "探头组装",
      "level": "关键工序"
    },
    {
      "id": "REQ-探头组装-03",
      "description": "外观无破损、脏污等不良",
      "process": "探头组装",
      "level": "关键工序"
    },
    {
      "id": "REQ-探头组装-04",
      "description": "拿取传感器时，不得抓取传感器腿，以免造成传感器腿粘连、弯曲影响传感器板装配",
      "process": "探头组装",
      "level": "关键工序"
    },
    {
      "id": "REQ-探头组装-05",
      "description": "探头放置平稳",
      "process": "探头组装",
      "level": "关键工序"
    },
    {
      "id": "REQ-探头组装-06",
      "description": "压合后高度：14.1±0.1mm",
      "process": "探头组装",
      "level": "关键工序"
    },
    {
      "id": "REQ-探头组装-07",
      "description": "传感器、散热套无松动现象",
      "process": "探头组装",
      "level": "关键工序"
    },
    {
      "id": "REQ-探头组装-08",
      "description": "设备压力调节0.6±0.05MPa，时间调节在3±1秒",
      "process": "探头组装",
      "level": "关键工序"
    },
    {
      "id": "REQ-涂硅脂-01",
      "description": "涂抹均匀，不得涂抹到传感器脚",
      "process": "涂抹硅脂",
      "level": "关键工序"
    },
    {
      "id": "REQ-焊探头-01",
      "description": "插装到位",
      "process": "焊探头到PCB",
      "level": "关键工序"
    },
    {
      "id": "REQ-焊探头-02",
      "description": "焊点饱满圆润，无漏焊、虚焊、脱焊、立碑、桥接、拉尖等不良缺陷",
      "process": "焊探头到PCB",
      "level": "关键工序"
    },
    {
      "id": "REQ-焊线-01",
      "description": "红线焊在PCB丝印\"1\"位置",
      "process": "导线焊到探头板上",
      "level": "重要"
    },
    {
      "id": "REQ-焊线-02",
      "description": "白线焊在PCB丝印\"2\"位置",
      "process": "导线焊到探头板上",
      "level": "重要"
    },
    {
      "id": "REQ-焊线-03",
      "description": "黑线焊在PCB丝印\"3\"位置",
      "process": "导线焊到探头板上",
      "level": "重要"
    },
    {
      "id": "REQ-支架-01",
      "description": "检验探头焊点，无虚焊、漏焊、连焊现象",
      "process": "探头支架组装",
      "level": "重要"
    },
    {
      "id": "REQ-支架-02",
      "description": "探头放置平稳无虚位、晃动现象",
      "process": "探头支架组装",
      "level": "重要"
    },
    {
      "id": "REQ-支架-03",
      "description": "螺钉安装到位",
      "process": "探头支架组装",
      "level": "重要"
    },
    {
      "id": "REQ-三防漆-01",
      "description": "三防漆涂抹均匀，不得粘连到其他部件",
      "process": "探头涂三防漆",
      "level": "重要"
    },
    {
      "id": "REQ-三防漆-02",
      "description": "三防漆涂抹必须完全覆盖传感器的四个焊点",
      "process": "探头涂三防漆",
      "level": "重要"
    },
    {
      "id": "REQ-SMT-01",
      "description": "焊接元器件正确，PCB板上相应贴片元件需与BOM中元器件名称规格一一对应，带极性元器件焊接方向正确",
      "process": "贴片",
      "level": "关键工序"
    },
    {
      "id": "REQ-SMT-02",
      "description": "元器件不能有缺口、破裂和烫伤，元器件焊接高度不影响装配，PCB板不能有破损、变形、翘曲，表面清洁、无焊料小圆球",
      "process": "贴片",
      "level": "关键工序"
    },
    {
      "id": "REQ-SMT-03",
      "description": "焊点要表面润湿、完整、连续和圆滑，焊料量适中，焊点位置准确，无漏焊、虚焊、脱焊、立碑、桥接、拉尖等不良缺陷",
      "process": "贴片",
      "level": "关键工序"
    },
    {
      "id": "REQ-检测-01",
      "description": "电池电压在2.7V到3.3V之间",
      "process": "主板贴片检测",
      "level": "关键工序"
    },
    {
      "id": "REQ-检测-02",
      "description": "外部NTC温度在23℃到27℃之间（此处为10K的标准电阻）",
      "process": "主板贴片检测",
      "level": "关键工序"
    },
    {
      "id": "REQ-检测-03",
      "description": "红外传感器测温应在10℃到40℃之间",
      "process": "主板贴片检测",
      "level": "关键工序"
    },
    {
      "id": "REQ-检测-04",
      "description": "休眠电流应小于30uA",
      "process": "主板贴片检测",
      "level": "关键工序"
    },
    {
      "id": "REQ-蜂鸣器-01",
      "description": "放置平稳",
      "process": "在主板上焊接蜂鸣器",
      "level": "重要"
    },
    {
      "id": "REQ-蜂鸣器-02",
      "description": "蜂鸣器本体紧贴PCB",
      "process": "在主板上焊接蜂鸣器",
      "level": "重要"
    },
    {
      "id": "REQ-蜂鸣器-03",
      "description": "焊点圆滑饱满，不可出现拉尖、连焊、虚焊、漏焊",
      "process": "在主板上焊接蜂鸣器",
      "level": "重要"
    },
    {
      "id": "REQ-弹簧-01",
      "description": "放置平稳",
      "process": "在主板上焊接电池正负极弹簧",
      "level": "重要"
    },
    {
      "id": "REQ-弹簧-02",
      "description": "正负极簧本体紧贴PCB",
      "process": "在主板上焊接电池正负极弹簧",
      "level": "重要"
    },
    {
      "id": "REQ-弹簧-03",
      "description": "焊点圆滑饱满，不可出现拉尖、连焊、虚焊、漏焊",
      "process": "在主板上焊接电池正负极弹簧",
      "level": "重要"
