  "semantic_fragments": [
    {
      "fragment_type": "design_rationale",
      "content": "主板 PCB 外形细长不规则（84.7×24.4 mm），含多处凸凹避让结构。顶部多段（43.4/43.2/40/34.4/27.6/20.15/14 mm）指示顶部有多个台阶状凸出/凹陷；右侧多段（21.2/18.2/16.2/9.2 mm）指示右侧有多个高度变化的避让。强烈提示主板需避让壳体内部多处结构（电池仓、按键开口、传感器筒、螺柱凸台等）。",
      "topic_tags": [
        "PCB外形",
        "避让结构",
        "装配约束",
        "不规则外形"
      ],
      "related_subjects": [
        "T-Z1-P13",
        "T-Z1-P02下盖",
        "T-Z1-P05按键",
        "传感器PCB"
      ]
    },
    {
      "fragment_type": "behavioral_spec",
      "content": "典型 PT9L 主板功能区分析：MCU（微控制器，控制全机）；LCD 段码驱动（通过斑马条接 LCD 16个PIN）；按键检测电路（tact switch × 2，对应开关帽+按键 P05）；电池电源管理（AAA × 2 = 3V 系统）；与传感器 PCB 的接口（4-Ø0.7/2-Ø0.8 焊孔可能是连接焊点）；蜂鸣器驱动（看是否有蜂鸣器焊盘）；充电/USB 可能无（PT9L AAA 电池供电）。",
      "topic_tags": [
        "主板功能",
        "MCU",
        "LCD驱动",
        "按键检测",
        "电源管理",
        "蜂鸣器",
        "传感器接口"
      ],
      "related_subjects": [
        "T-Z1-P13",
        "PT9L系统",
        "传感器PCB T-Z1-P14"
      ]
    },
    {
      "fragment_type": "constraint_statement",
      "content": "主板板厚 1.0 mm 与传感器 PCB（T-Z1-P14）同厚，可能用同一规格 FR4 卷材批次加工。公差等级 SELECT LEVEL B，外形和孔径整体按 Level B 默认 ±0.1 mm 执行。无 IQC 编号尺寸。",
      "topic_tags": [
        "板厚",
        "FR4",
        "公差等级",
        "制造约束"
      ],
      "related_subjects": [
        "T-Z1-P13",
        "T-Z1-P14传感器PCB"
      ]
    },
    {
      "fragment_type": "design_rationale",
      "content": "PT9L 系统采用双 PCB 架构：主板（T-Z1-P13，84.7×24.4×1.0 mm）与传感器 PCB（T-Z1-P14）配对，两者通过排线或焊接实现电气连接。主板承担主控功能，传感器 PCB 承担传感功能，分板设计有利于传感器部分的独立安装与替换。",
      "topic_tags": [
