    {
      "id": "DI-LVD-01",
      "description": "低压检测：通过SR1、SR2分压，输出信号AI_LVD至MCU，用于检测电池欠压状态"
    },
    {
      "id": "DI-SENSOR-01",
      "description": "红外传感器模块内含热电堆及NTC基准温度传感器，输出信号AI_AND接MCU模拟输入"
    },
    {
      "id": "DI-NTC-01",
      "description": "NTC热敏电阻（NTC2/NTC3）上拉至VCM，用于环境温度补偿"
    },
    {
      "id": "DI-BEEP-01",
      "description": "无源蜂鸣器工作频率4kHz，由DO_BUZ信号驱动"
    },
    {
      "id": "DI-LCD-01",
      "description": "LCD接口：COM0–COM3（4条公共线），SEG0–SEG15（16条段选线）"
    }
  ],
