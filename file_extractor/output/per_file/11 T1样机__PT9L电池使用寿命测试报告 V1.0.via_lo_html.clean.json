  "tests": [
    {
      "test_id": "动态功耗测试",
      "item": "动态功耗测量",
      "condition": "使用两节七号干电池供电，串入万用表电流档，模拟一次用户测量过程，从按键唤醒到自动进入待机，重复几轮取平均值",
      "expected_value": "满足设计输入要求",
      "actual_result": "平均值12.7mA；连续工作时间：1000mAh*0.6/12.7mA=47.24h",
      "pass_criteria": "满足设计输入的要求",
      "environment": "温度22℃；湿度55%"
    },
    {
      "test_id": "静态功耗测试",
      "item": "静态功耗测量",
      "condition": "使用两节七号干电池供电，串入万用表电流档，模拟一次用户测量过程，从按键唤醒到自动进入待机后开始测量，重复几轮取平均值",
      "expected_value": "满足设计输入要求",
      "actual_result": "平均值8.1uA；待机时间：1000mAh*1000*0.6/8.1uA/24/30=102.88月",
      "pass_criteria": "满足设计输入要求",
      "environment": "温度22℃；湿度55%"
    }
  ],
  "test_reports": [
    {
      "report_id": "PT9L-BLTR01 V1.0",
      "conclusion": "此测试方法是模拟人体测试，通过测试不同状态的功耗推算出连续工作时间（47.24h）和待机时间（102.88月），满足设计输入的要求。"
    }
  ],
