  "semantic_fragments": [
    {
      "fragment_type": "scope_limitation",
      "content": "本软件应适用于所有年龄段的人从额头皮肤表面间歇性测量体温。它可以由消费者在家庭环境中使用，也可以由医疗保健提供者使用。",
      "topic_tags": [
        "预期用途",
        "用户特征",
        "使用场景",
        "体温测量"
      ],
      "related_subjects": [
        "PT9L红外体温计",
        "软件需求规格书"
      ]
    },
    {
      "fragment_type": "behavioral_spec",
      "content": "人机交互描述-测量：上电后系统进行初始化设置，LCD全屏显示。待显示关闭之后，对准被测额面按下测量按键，1秒内测量结束后，LCD显示测量结果，当电池电量不足时，LCD在显示结果时会同时显示电池符号提醒，蜂鸣器也会给出蜂鸣提示。",
      "topic_tags": [
        "人机接口",
        "测量流程",
        "LCD显示",
        "蜂鸣器",
        "低电提示"
      ],
      "related_subjects": [
        "初始化功能",
        "测量功能",
        "低电压检测功能",
        "LCD显示功能"
      ]
    },
    {
      "fragment_type": "constraint_statement",
      "content": "软件与安全相关的要求：\n1. 危害：显示信息不明确；危害处境：患者、操作者将显示的信息理解错误；计划控制措施：软件控制显示的信息，说明书解释显示的信息。\n2. 危害：不正确的算法；危害处境：患者、操作者使用了算法不正确的设备；计划控制措施：软件控制。\n3. 危害：不正确的测试结果存储，包括结果分组和时间的对应；危害处境：患者、操作者查询错误的记忆值；计划控制措施：软件控制。",
      "topic_tags": [
        "安全要求",
        "危害分析",
        "风险控制",
        "软件安全"
      ],
      "related_subjects": [
        "PT9L-FXPJ01 V1.0",
        "LCD显示功能",
        "记忆功能",
        "测量功能"
      ]
    },
    {
      "fragment_type": "constraint_statement",
      "content": "软件接受的阈值或特殊值：人体温度显示范围：最大42.9℃、最小32℃；环境温度：最大40℃、最小10℃。错误描述：被测温度低于32℃或高于42.9℃；环境温度高于40℃或低于10℃。",
      "topic_tags": [
        "阈值",
        "量程",
        "温度范围",
        "错误检测"
      ],
      "related_subjects": [
        "错误检测功能",
        "测量功能",
        "性能要求"
      ]
    },
    {
      "fragment_type": "behavioral_spec",
      "content": "软件系统的信号输入：红外传感器信号输入、电池电量采集信号输入、按键触发信号输入、E2PROM数据读取。软件系统信号输出：蜂鸣器驱动信号、LCD显示信号输出。",
      "topic_tags": [
        "信号输入",
        "信号输出",
        "接口",
        "传感器",
