  "software_items": [
    {
      "item_type": "MCU",
      "name": "BH67F2762",
      "description": "单片机系统，运行本软件",
      "run_environment": "无操作系统"
    },
    {
      "item_type": "存储器",
      "name": "RAM",
      "value": "1K字节",
      "run_environment": "单片机内部"
    },
    {
      "item_type": "存储器",
      "name": "ROM",
      "value": "16K字节",
      "run_environment": "单片机内部"
    },
    {
      "item_type": "存储器",
      "name": "EEPROM",
      "value": ">=256字节",
      "run_environment": "单片机外部/内部"
    }
  ],
  "functions": [
    {
      "name": "初始化功能",
      "description": "在上电后或者关机态，按按键，体温计能开机并打开LCD显示；MCU系统功能初始化，配置相关模块和功能设置。"
    },
    {
      "name": "关机功能",
      "description": "测量结束后不管是否测量成功，如果没有按键按下，机器会在15秒后自动关机；测量模式设置界面设置完成后，没有按键按下，机器会在3秒后自动关机。"
    },
    {
      "name": "LCD显示功能",
      "description": "LCD显示包括测量结果的数字显示，℃图标，℉图标，电池图标，静音图标，体温图标，物温图标。"
    },
    {
      "name": "蜂鸣器提示功能",
      "description": "在测试完成、设置完成以及按键操作时应该有蜂鸣器提示音，同时提示音也可以随时关闭。"
    },
    {
      "name": "低电压检测功能",
      "description": "低电提示分两阶段，当电量低于第一阶段时，能够保证设备至少能测量20次；当电量低于第二阶段时，设备关机。"
    },
    {
      "name": "测量模式设置功能",
      "description": "通过设置按键选择婴儿体温、成人体温、物温模式。"
    },
    {
      "name": "单位切换功能",
      "description": "通过按键切换摄氏度和华氏度单位。"
    },
    {
      "name": "测量功能",
      "description": "短按测量按键，1秒内完成测量，测量结束后蜂鸣器提示，且LCD显示测量结果；深度测量，长按按键2秒后完成测量，测量结束后蜂鸣器提示，且LCD显示测量结果。"
    },
    {
      "name": "错误检测功能",
      "description": "工作环境温度超出范围给出错误提示；测量结果超出量程，给出提示。"
    },
    {
      "name": "记忆功能",
      "description": "能够存储40条测量数据，并支持查看。"
    }
  ],
