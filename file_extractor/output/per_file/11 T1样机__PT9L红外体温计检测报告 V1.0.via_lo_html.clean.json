{
  "document": {
    "title": "PT9L红外体温计检测报告",
    "doc_type": "检测报告",
    "version": "V1.0"
  },
  "tests": [
    {
      "test_id": "1",
      "item": "上电自检功能",
      "expected_value": "产品上电后会进入上电自检：白色背光灯点亮，LCD显示屏全显，此时检查显示内容是否正确，是否有乱显，多显，少显现象，同时蜂鸣器响0.5S，2S后进入待机模式（若自检故障，屏幕全亮且闪烁）。",
      "actual_result": "1号：符合要求；2号：符合要求",
      "pass_criteria": "合格",
      "environment": "室温：23℃，相对湿度：55%"
    },
    {
      "test_id": "2",
      "item": "提示音开关",
      "expected_value": "通过机器侧面静音键控制提示音，当静音键置于关时，屏幕出现静音符号，此时提示音关；当静音键置于开时，屏幕上静音符号消失，此时提示音开。测试方法：机器每次测温时，完成温度测量后显示测量结果，如果目标温度正常，按设定蜂鸣；若测量错误，显示三条杠和温度单位，按设定蜂鸣。",
      "actual_result": "1号：符合要求；2号：符合要求",
      "pass_criteria": "合格",
      "environment": "室温：23℃，相对湿度：55%"
    },
    {
      "test_id": "3",
      "item": "测量单位切换",
      "expected_value": "1.待机状态下长按测量键8秒，进入单位切换状态；2.短按测量键切换℃或℉单位，对应的单位符号闪烁，并伴有短蜂鸣一声；3.长按测量键2秒以确认所选单位，对应的单位符号将常亮2秒并伴有短蜂鸣一声。之后体温计将自动关机。",
      "actual_result": "1号：符合要求；2号：符合要求",
      "pass_criteria": "合格",
      "environment": "室温：23℃，相对湿度：55%"
    },
    {
      "test_id": "4",
      "item": "测量模式切换",
      "expected_value": "测量状态下短按设置按键进入模式切换状态，短按设置键循环切换婴儿模式，成人模式和物温模式，LCD屏上对应图标显示。",
      "actual_result": "1号：符合要求；2号：符合要求",
      "pass_criteria": "合格",
      "environment": "室温：23℃，相对湿度：55%"
    },
    {
      "test_id": "5",
      "item": "自动关机",
      "expected_value": "测温后无操作 15±1S 自动转入待机模式。",
      "actual_result": "1号：符合要求；2号：符合要求",
      "pass_criteria": "合格",
      "environment": "室温：23℃，相对湿度：55%"
    },
    {
      "test_id": "6",
      "item": "温度显示范围及超温提示功能",
      "expected_value": "要求：32℃~42.9℃；32.4℃、42.5℃可正确显示温度，31.6℃和43.4℃无法显示温度，屏显\"--.-\"报错。",
      "actual_result": "1号：见测试记录一；2号：见测试记录一",
      "pass_criteria": "合格",
      "environment": "室温：23℃，相对湿度：55%"
    },
    {
      "test_id": "7",
      "item": "显示分辨率",
      "expected_value": "要求：0.1℃；实验室环境中，黑体温度变化在0.1℃--0.15℃，显示数值应随之发生改变。",
      "actual_result": "1号：0.1℃；2号：0.1℃",
      "pass_criteria": "合格",
      "environment": "室温：23℃，相对湿度：55%"
    },
    {
      "test_id": "8",
      "item": "常温精度测试",
      "condition": "环境要求：室温：23.0±2.0℃ 相对湿度：50%RH±20%RH；将恒温水槽分别设定在32℃、32.5℃、35℃、38.5℃、42℃、42.5℃、42.9℃",
      "expected_value": "精度要求：≥35℃且≤42℃：±0.2℃，其它：±0.3℃",
      "actual_result": "1号：见测试记录二；2号：见测试记录二",
      "pass_criteria": "合格",
      "instrument": "恒温水槽",
      "environment": "室温：23.0±2.0℃，相对湿度：50%RH±20%RH"
    },
    {
      "test_id": "9",
      "item": "低电压提示功能",
      "expected_value": "3.0V时能正常测量；低于2.7V时仍可测量但低电符号随测量结果显示；低于2.5V时屏幕单独闪烁显示低电图标，15秒后自动关机。",
      "actual_result": "1号：符合要求；2号：符合要求",
      "pass_criteria": "合格",
      "instrument": "可调直流稳压电源",
      "environment": "室温：23℃，相对湿度：55%"
    },
    {
      "test_id": "10",
      "item": "背光灯",
      "condition": "环境要求：室温：24℃-26℃ 相对湿度：30%-70%；将恒温水槽分别设定在34℃、35.7℃、37℃",
      "expected_value": "测试34℃水槽时背光应为白色，测试35.7℃水槽时背光应为橙色，测试37℃水槽时背光应为红色。",
      "actual_result": "1号：见测试记录三；2号：见测试记录三",
      "pass_criteria": "合格",
      "instrument": "恒温水槽",
      "environment": "室温：24℃-26℃，相对湿度：30%-70%"
    },
    {
      "test_id": "11",
      "item": "静态电流",
      "condition": "电源电压DC3.0V，省电模式（睡眠状态）",
      "expected_value": "标准：≤0.02mA",
      "actual_result": "静态电流：8.1uA",
      "pass_criteria": "合格",
      "instrument": "万用表、可调直流稳压电源"
    },
    {
      "test_id": "12",
      "item": "工作电流",
      "condition": "电源电压DC3.0V，按测量键测量时LCD背光点亮",
      "expected_value": "标准：工作电流≤20mA（工作中任意状态）",
      "actual_result": "工作电流：12.7mA",
      "pass_criteria": "合格",
      "instrument": "万用表、可调直流稳压电源"
    },
    {
      "test_id": "13",
      "item": "裸机跌落测试",
      "condition": "产品在开机状态下，跌落高度1.0米，跌落正下方用平整硬木板作基垫，垂直于地面自由落下；跌3次，依次底部、LCD面、有测量键面朝下各一次；基垫为密度700kg/M3、厚度50mm的硬质木板或混凝土地面",
      "expected_value": "跌落后产品没有开裂，PCB板元器件没有损伤，产品结构功能完好。",
      "actual_result": "1号：符合要求；2号：符合要求",
      "pass_criteria": "合格"
    },
    {
      "test_id": "14",
      "item": "带包装振动",
      "condition": "将1箱成品以不同方向放置在测试机上固定好；振动条件：5Hz-35Hz-5Hz，振幅：0.35mm，振动方向：X，Y，Z，振动次数：各15次（Z方向振动时外箱处于自由状态）",
      "expected_value": "1）不可看到被包装物品，边角不可破裂；2）测试后误差须在第8项允许范围内。",
      "actual_result": "1号：见测试记录四；2号：见测试记录四",
      "pass_criteria": "合格"
    },
    {
      "test_id": "15",
      "item": "低温工作试验",
      "condition": "在10℃恒温箱中放置24h之后，常温下恢复1h，按照第8项进行测试",
      "expected_value": "要求：温度10℃~40℃，相对湿度：≤95%不结露，大气压力：70kPa～106kPa；测量结果应满足设计要求。",
      "actual_result": "1号：见测试记录五；2号：见测试记录五",
      "pass_criteria": "合格"
    },
    {
      "test_id": "16",
      "item": "高温工作试验",
      "condition": "在40℃恒温箱中放置24h之后，常温下恢复1h，按照第8项进行测试",
      "expected_value": "要求：温度10℃~40℃，相对湿度：≤95%不结露，大气压力：70kPa～106kPa；测量结果应满足设计要求。",
      "actual_result": "1号：见测试记录六；2号：见测试记录六",
      "pass_criteria": "合格"
    },
    {
      "test_id": "17",
      "item": "低温存储试验",
      "condition": "在-20℃恒温箱中放置48h之后，常温下恢复1h，按照第8项进行测试",
      "expected_value": "要求：温度-20℃~55℃，相对湿度：≤95%不结露，大气压力：70kPa～106kPa；测量结果应满足设计要求。",
      "actual_result": "1号：见测试记录七；2号：见测试记录七",
      "pass_criteria": "合格"
    },
    {
      "test_id": "18",
      "item": "高温存储试验",
      "condition": "在55℃恒温箱中放置48h之后，常温下恢复1h，按照第8项进行测试",
      "expected_value": "要求：温度-20℃~55℃，相对湿度：≤95%不结露，大气压力：70kPa～106kPa；测量结果应满足设计要求。",
      "actual_result": "1号：见测试记录八；2号：见测试记录八",
      "pass_criteria": "合格"
    },
    {
      "test_id": "19",
      "item": "产品寿命",
      "condition": "选取5个样品实际测量1万次，测试前和测试后都按照第8项进行测试",
      "expected_value": "要求：五年或10000次；精度和功能均需正常。",
      "actual_result": "整机寿命测试报告",
      "pass_criteria": "合格"
    },
    {
      "test_id": "20",
      "item": "电池寿命",
      "condition": "模拟人体测试，通过测试不同状态的功耗推算出连续工作时间和待机时间",
      "expected_value": "要求：测量次数≥1000次，待机能力≥6个月",
      "actual_result": "符合要求",
      "pass_criteria": "合格"
    }
  ],
