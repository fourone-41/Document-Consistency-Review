{
  "document": {
    "title": "用户现场测试计划 PT9C V1.0",
    "doc_type": "用户现场测试计划",
    "version": "V1.0"
  },
  "tests": [
    {
      "test_id": "1",
      "item": "安装电池",
      "expected_value": "电池安装完毕后，LCD全显，且蜂鸣器\"滴\"一下",
      "pass_criteria": "正常完成安装，LCD全显，蜂鸣器响一下"
    },
    {
      "test_id": "2",
      "item": "在婴儿模式测量体温",
      "expected_value": "待机状态下，用户按键测量额温，LCD能显示体温数据",
      "pass_criteria": "LCD正常显示体温数据，至少测量3次"
    },
    {
      "test_id": "3",
      "item": "在成人模式测量体温",
      "expected_value": "显示婴儿体温数据状态下，用户短按设置按键，切换到成人模式，短按测量键测量额温，LCD能显示体温数据",
      "pass_criteria": "LCD正常显示体温数据，至少测量3次"
    },
    {
      "test_id": "4",
      "item": "在物温模式测量物温",
      "expected_value": "显示成人体温数据状态下，用户短按设置按键，切换到物温模式，短按测量键测量恒温物体物温，LCD能显示物温数据",
      "pass_criteria": "LCD正常显示物温数据，至少测量3次"
    },
    {
      "test_id": "5",
      "item": "关机",
      "expected_value": "测量结束后，不对体温计操作，等待关机",
      "pass_criteria": "自动关机时间合理"
    },
    {
      "test_id": "6",
      "item": "准确性测试",
      "expected_value": "使用经过校验的体温计测量成人体温3次，再使用水银体温计测量腋温1次",
      "pass_criteria": "无异常测试现象"
    },
    {
      "test_id": "7",
      "item": "重复性测试",
      "expected_value": "用户测量成人体温，测量10次，分别记录10次的测量值",
      "pass_criteria": "无异常测试现象"
    },
    {
      "test_id": "8",
      "item": "体温计的LCD显示",
      "expected_value": "LCD亮度感受良好，显示内容明确易懂",
      "pass_criteria": "用户反馈LCD亮度和显示内容良好"
    },
    {
      "test_id": "9",
      "item": "体温计的反应速度",
      "expected_value": "反应迅速，测量过程快，简单易用",
      "pass_criteria": "用户反馈反应速度合理"
    }
  ],
  "persons": [
