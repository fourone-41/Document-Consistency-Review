  "semantic_fragments": [
    {
      "fragment_type": "scope_limitation",
      "content": "评审阶段：方案规划，具体为软件方案评审（已勾选）。其余未勾选项包括：结构方案评审、硬件方案评审、软件质量策划评审、软件需求规格书评审。",
      "topic_tags": [
        "评审阶段",
        "方案规划",
        "软件方案评审"
      ],
      "related_subjects": [
        "PT9L",
        "30000078"
      ]
    },
    {
      "fragment_type": "behavioral_spec",
      "content": "评审内容：1. 对软件设计方案的评估：评审内容见附表（文件编号：PT9L-RFPB01 V1.0）；2. 评估出的问题、原因及采取的纠正措施、负责人、完成日期；3. 在本阶段进行的设计更改，如设计更改需求评审中确定其未影响预期用途及设计输入，即只影响设计输出的设计更改，本次评审时需评估设计更改的适宜性及是否引起了新的问题；4. 对设计进度的评估。",
      "topic_tags": [
        "评审内容",
        "软件设计方案",
        "设计更改",
        "设计进度"
      ],
      "related_subjects": [
        "PT9L-RFPB01 V1.0"
      ]
    },
    {
      "fragment_type": "constraint_statement",
      "content": "接收准则：1. 软件设计方案评审内容表中，所有条目需识别其适用性，适用的条目需评估其是否通过；2. 对评估出的问题，需在评审记录中明确产生问题的原因以及采取的纠正措施、负责人和完成日期；3. 如有设计更改，则更改解决了原有问题，且没有引起新的问题，如有新的问题，需追踪直至解决；4. 设计进度符合项目进度表的时间要求，或者更新项目进度表并得到批准。",
      "topic_tags": [
        "接收准则",
        "适用性",
        "纠正措施",
        "设计更改",
        "进度"
      ],
      "related_subjects": [
        "软件设计方案评审内容表"
      ]
    },
    {
      "fragment_type": "behavioral_spec",
      "content": "人员职责：技术负责人：对软件设计方案询问信息、提出问题等，对其可行性、合理性等进行评审；软件主管：对软件设计方案询问信息、提出问题等，对其可行性、合理性及项目进度等进行评审；软件工程师：主持软件设计方案评审，解答问题和/或承诺改进软件需求规格，并形成评审记录；对本阶段不负直接责任的人员：负责从不同的视角提出问题，以保持评审的独立性。",
      "topic_tags": [
        "人员职责",
        "技术负责人",
        "软件主管",
        "软件工程师",
        "独立性"
      ],
      "related_subjects": [
        "侯广伟",
        "王迪",
        "王迪龙"
      ]
    }
  ],
